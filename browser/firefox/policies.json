{
  "__comment": [
    "LOCKED-DEVICE Firefox policy (kid laptop / shared PC). NOT for your own machine —",
    "for that, setup.sh installs the per-user managed-storage manifests in ../ublock and ../hush instead.",
    "This file force-installs uBlock Origin + Hush, blocks every other extension, pins uBO's",
    "filter lists to this repo, and locks the escape hatches (DoH, private browsing, about:config).",
    "Install:  sudo ./setup.sh --locked   (copies to /etc/firefox/policies/policies.json; the Ubuntu snap reads it too)",
    "Check:    about:policies. Firefox for ANDROID does NOT read this file.",
    "Hush install_url: point it at a hosted signed .xpi (npm run sign -> web-ext-artifacts/, attach to a GitHub release).",
    "The 3rdparty block is the same data as ../ublock/managed-storage.json (keys verified against uBO's storage.js)."
  ],
  "policies": {
    "DNSOverHTTPS": { "Enabled": false, "Locked": true },
    "DisablePrivateBrowsing": true,
    "BlockAboutConfig": true,
    "Preferences": {
      "media.autoplay.default": { "Value": 5, "Status": "locked" },
      "media.autoplay.blocking_policy": { "Value": 2, "Status": "locked" }
    },
    "ExtensionSettings": {
      "*": { "installation_mode": "blocked" },
      "uBlock0@raymondhill.net": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "private_browsing": true
      },
      "word-block@emmanueljanssens.dev": {
        "installation_mode": "force_installed",
        "install_url": "https://github.com/Heymanuel303/hush/releases/latest/download/hush.xpi",
        "private_browsing": true
      }
    },
    "3rdparty": {
      "Extensions": {
        "uBlock0@raymondhill.net": {
          "disableDashboard": true,
          "userSettings": [
            ["webrtcIPAddressHidden", "true"],
            ["prefetchingDisabled", "true"],
            ["hyperlinkAuditingDisabled", "true"],
            ["cnameUncloakEnabled", "true"],
            ["largeMediaSize", "50"]
          ],
          "toOverwrite": {
            "filterLists": [
              "user-filters",
              "ublock-filters",
              "ublock-badware",
              "ublock-privacy",
              "ublock-unbreak",
              "ublock-quick-fixes",
              "easylist",
              "easyprivacy",
              "urlhaus-1",
              "plowe-0",
              "ublock-annoyances",
              "easylist-annoyances",
              "ublock-cookies-easylist",
              "fanboy-cookiemonster",
              "https://raw.githubusercontent.com/Heymanuel303/hush/main/filters/youtube-cleanup.txt",
              "https://raw.githubusercontent.com/Heymanuel303/hush/main/filters/social-cleanup.txt",
              "https://raw.githubusercontent.com/Heymanuel303/hush/main/filters/strict-mode.txt"
            ],
            "filters": [
              "! managed by browser/firefox/policies.json — edit the repo lists, not here"
            ]
          }
        },
        "word-block@emmanueljanssens.dev": {
          "blockWords": ["giveaway", "sponsored", "=ai", "clickbait"],
          "enabledPacks": ["Search Spam"],
          "siteWords": {
            "Reddit": ["r/popular", "AMA"],
            "X": ["trending"],
            "YouTube": ["#shorts", "reaction"],
            "Google": ["pinterest"]
          },
          "ytHomeRedirect": true
        }
      }
    }
  }
}
