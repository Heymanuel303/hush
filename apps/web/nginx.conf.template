# Rendered by the nginx image's envsubst step at container start: only ${API_UPSTREAM} is
# substituted (it is the one environment variable the image defines); nginx variables such
# as $host and $upstream stay as they are.

# Keep the scheme Caddy saw (https) instead of this hop's http.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Same-origin api. Docker's DNS (127.0.0.11) is re-resolved every 10s and the upstream is
  # a variable, so nginx spreads requests over every api replica and follows restarts.
  location /api/ {
    resolver 127.0.0.11 valid=10s;
    set $upstream ${API_UPSTREAM};
    proxy_pass $upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # Vite hashes asset file names, so they can be cached forever.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # SPA fallback: unknown paths serve index.html, which must never be cached.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
