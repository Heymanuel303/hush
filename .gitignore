.DS_Store

# --- Extension (src/): kept from the pre-hub .gitignore ---
# Secrets: NEVER commit signing credentials.
.env.*
!.env.example

# Build / signing output.
web-ext-artifacts/
*.xpi
*.zip

# web-ext bookkeeping.
.amo-upload-uuid
**/.amo-upload-uuid

# Node / editor / OS cruft.
npm-debug.log*
yarn-error.log*
.npm/
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Browser captures (HAR files are huge and may contain cookies).
*.har

# ESLint cache of apps/web (`eslint --cache`).
.eslintcache

# pnpm puts its content store at the filesystem root when /workspace is its own mount.
.pnpm-store/

# TypeScript incremental build info (apps/api `nest build`).
*.tsbuildinfo
e2e/.auth/
